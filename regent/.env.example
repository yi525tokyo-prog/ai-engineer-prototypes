# Storage (PostgreSQL preferred; sqlite:///./var/regent.db also works for quick local runs)
REGENT_DATABASE_URL=postgresql+psycopg://regent:regent@localhost:5432/regent

# Model providers. Missing keys are reported explicitly at GET /api/system; the local
# deterministic strategist is always available so the loop never blocks on credentials.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Tool credentials (missing -> local/mock backend is used and reported as degraded)
REGENT_SEARCH_API_KEY=
GITHUB_TOKEN=
REGENT_GLOBAL_BRAIN_URL=

# Runtime
REGENT_WORKSPACE=./var/workspace
REGENT_BACKGROUND_LOOP=1
REGENT_PUBLIC_API_URL=http://localhost:8000
